# =============================================================================
# Plantilla del .env SÍ commiteable. Completar copiando el archivo
# "infra/n8n/.env" que Sonia entrega por privado -> NUNCA subir al repo.
# Convenio: los valores entre <...> son ejemplos de formato, no secretos.
# =============================================================================

# --- Identidad de la instancia (cada máquina es dueña de la suya) ------------
# Puede dejarse vacío: "sembrar-n8n" genera una clave aleatoria propia y la
# guarda en este mismo archivo. NO compartir la N8N_ENCRYPTION_KEY de otra
# instalación: invalidaría las credenciales cifradas de esta.
N8N_ENCRYPTION_KEY=
# No usar 5679: es el puerto por defecto del Task Broker de n8n 2.x y el contenedor
# entra en crash-loop. 5678 es el puerto por defecto; cambiá solo acá (host),
# el interno del contenedor permanece 5678.
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
N8N_USER_MANAGEMENT_DISABLED=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
NODE_FUNCTION_ALLOW_BUILTIN=*

# --- Admin local de n8n -------------------------------------------------------
# Si quedan vacías, sembrar-n8n crea admin@gymbro.tp con contraseña generada
# (guardada solo en este archivo, sin imprimirla en consola).
N8N_ADMIN_EMAIL=
N8N_ADMIN_PASSWORD=
N8N_ADMIN_FIRSTNAME=
N8N_ADMIN_LASTNAME=

# --- MantisBT (WF1) -----------------------------------------------------------
# URL base del Mantis local (web), sin barra final. Token: ver GUIA-COMPANEROS.
MANTIS_URL=http://host.docker.internal:8089
MANTIS_API_TOKEN=<token_compartido_por_Sonia>

# --- Prometheus (WF1 y WF3) ---------------------------------------------------
PROMETHEUS_URL=http://host.docker.internal:9090

# --- Nextcloud (WF3) -----------------------------------------------------------
NEXTCLOUD_URL=http://host.docker.internal:8081/remote.php/dav/files/<usuario>
NEXTCLOUD_USER=<usuario_nextcloud>
NEXTCLOUD_PASSWORD=<password_nextcloud>

# --- PostgreSQL principal del equipo (WF2 backup) ------------------------------
# Corre en tu propia máquina (docker compose principal del repo).
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=55433
POSTGRES_USER=smartgymbro_tp
POSTGRES_DB=smartgymbro_tp
POSTGRES_PASSWORD=<password_compartida_del_equipo>

# --- Postgres temporal de restauración (WF-RESTORE) ----------------------------
# Vacía -> sembrar-n8n genera una contraseña propia para esta máquina.
RESTORE_TEST_PASSWORD=

# --- SMTP (OPCIONAL, NO se comparte) ------------------------------------------
# Gmail es excepción por política del TP: cada quien configura SU cuenta.
# Pasos: myaccount.google.com -> Seguridad -> Verificación en 2 pasos ->
# Contraseñas de aplicación -> crear "n8n" (16 caracteres). Pegarla abajo.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=<contraseña_de_aplicación_de_16_caracteres>
