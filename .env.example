# ==============================================================================
# SMARTGYMBRO - PLANTILLA MAESTRA DE ENTORNO (.env.example)
# Copiar este archivo como .env para levantar todo el proyecto:
#   copy .env.example .env
# ==============================================================================

# --- RED Y PUERTOS ---
DOMAIN=localhost

# --- BASE DE DATOS POSTGRESQL 17 ---
POSTGRES_DB=smartgymbro_tp
POSTGRES_USER=smartgymbro_tp
POSTGRES_PASSWORD=admin123
POSTGRES_PORT=55433

# --- REPLICACION Y CLUSTER ---
POSTGRES_REPLICA_PORT=55434
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator_password123

# --- CLIENTE PGADMIN 4 ---
PGADMIN_DEFAULT_EMAIL=admin@smartgymbro.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_secure_pass_2026
PGADMIN_PORT=5051

# --- BACKEND API (NODE 26) ---
PORT=3100
BACKEND_PORT=3100
NODE_ENV=development
DB_CONNECTION_MODE=LOCAL
DB_SCHEMA=gymbro
DB_NAMES_LANGUAGE=es
DATABASE_URL=postgresql://smartgymbro_tp:admin123@127.0.0.1:55433/smartgymbro_tp
JWT_SECRET=super_secreto_local_smartgymbro_2026_seguro_mas_de_32_chars
FRONTEND_URL=http://localhost:4300
PUBLIC_API_URL=http://localhost:3100
GEMINI_ENABLED=false

# --- FRONTEND (ANGULAR 22 + NGINX) ---
FRONTEND_PORT=4300

# --- NEXTCLOUD (GESTION DOCUMENTAL) ---
NEXTCLOUD_PORT=8081
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=smartgymbro_tp
NEXTCLOUD_TEAM_PASSWORD=SmartGym2026!

# --- MANTIS BUG TRACKER (INCIDENCIAS) ---
MANTIS_PORT=8089
MANTIS_DB_USER=mantis_user
MANTIS_DB_PASSWORD=mantis_password_seguro
MANTIS_DB_NAME=bugtracker

# --- MONITOREO (PROMETHEUS & GRAFANA) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
POSTGRES_DATA_SOURCE="postgresql://smartgymbro_tp:admin123@host.docker.internal:55433/smartgymbro_tp?sslmode=disable"
